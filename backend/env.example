# MongoDB Atlas — copie este arquivo para .env e preencha com seus dados reais
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.pxozldc.mongodb.net/astroproject?appName=Cluster0

# JWT — gere uma chave aleatória, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=1h

# Servidor
PORT=3000
NODE_ENV=development

# CORS — URL do seu frontend
FRONTEND_URL=http://localhost:5173
